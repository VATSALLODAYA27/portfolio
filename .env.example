# Copy to .env.production (or set in your host's dashboard) before you deploy.

# Your live URL, no trailing slash. Adds the canonical link and social-preview tags.
# Leave unset until you have a domain; the site builds fine without it.
VITE_SITE_URL=

# Only needed for GitHub Pages project sites, e.g. /portfolio/  (default: /)
VITE_BASE=
